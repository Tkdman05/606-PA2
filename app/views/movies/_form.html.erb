<!-- app/views/movies/_form.html.erb -->
<%= form_with(model: movie, local: true, class: 'movie-form') do |form| %>
  <% if movie.errors.any? %>
    <div class="error-container">
      <h3 class="error-title">
        ⚠️ <%= pluralize(movie.errors.count, "error") %> prevented this movie from being saved:
      </h3>
      <ul class="error-list">
        <% movie.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  
  <div class="form-group">
    <%= form.label :title, class: 'form-label' %>
    <%= form.text_field :title, class: 'form-input', placeholder: 'Enter movie title...', required: true %>
  </div>
  
  <div class="form-group">
    <%= form.label :rating, class: 'form-label' %>
    <%= form.select :rating, 
        options_for_select(['G', 'PG', 'PG-13', 'R', 'NC-17'], movie.rating), 
        { prompt: '-- Select a rating --' }, 
        { class: 'form-select', required: true } %>
  </div>
  
  <div class="form-group">
    <%= form.label :release_date, class: 'form-label' %>
    <%= form.date_field :release_date, class: 'form-input', required: true %>
  </div>
  
  <div class="form-actions">
    <%= form.submit class: 'btn btn-primary' %>
    <%= link_to 'Cancel', movies_path, class: 'btn btn-secondary' %>
  </div>
<% end %>